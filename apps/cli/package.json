    "@corelive/domain": "workspace:*",
    "@corelive/source-graphify": "workspace:*",
    "@corelive/storage-sqlite": "workspace:*",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
