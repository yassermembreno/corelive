{
  "name": "@corelive/cli",
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "corelive": "./src/cli.ts"
  },
  "main": "src/cli.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "test:e2e": "vitest run test/phase0-e2e.spec.ts test/phase1-query-e2e.spec.ts"
  },
  "dependencies": {
